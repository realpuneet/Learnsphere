# ---------- Core ----------
NODE_ENV=development
PORT=5000
APP_NAME=LearnSphere
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TZ=Asia/Kolkata
LOG_LEVEL=debug
START_WORKER=true

# ---------- Data ----------
MONGO_URI=mongodb://127.0.0.1:27017/learnsphere?replicaSet=rs0
# Uncomment if mongodb+srv fails with ECONNREFUSED querySrv (OS DNS cannot resolve SRV)
# DNS_SERVERS=8.8.8.8,1.1.1.1
REDIS_URL=redis://127.0.0.1:6379

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ---------- Commerce & policy (admins can override at runtime in Admin -> Settings) ----------
PLATFORM_FEE_PERCENT=20
GST_PERCENT=18
REFUND_WINDOW_DAYS=7
REFUND_MAX_PROGRESS=20
INACTIVITY_NUDGE_DAYS=7
# signs certificates – changing it invalidates verification of old certificates!
CERTIFICATE_SECRET=change-me-certificate-secret

# ---------- Razorpay (leave blank => dry-run payments) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- ImageKit (leave blank => uploads disabled; paste image URLs instead) ----------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ---------- Social login (leave blank => buttons hidden) ----------
# Google: OAuth Web client id (Google Cloud Console -> Credentials); add http://localhost:5173 as authorised JS origin
GOOGLE_CLIENT_ID=
# LinkedIn: "Sign In with LinkedIn using OpenID Connect" product; redirect URI must match exactly
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/api/v1/auth/linkedin/callback
RESET_TOKEN_TTL_MIN=30

# ---------- Email (leave SMTP_HOST blank => dry-run: logs only) ----------
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="LearnSphere <no-reply@learnsphere.example>"

# ---------- Admin seed ----------
SEED_ADMIN_EMAIL=admin@learnsphere.local
SEED_ADMIN_PASSWORD=Admin@12345
